  "precedence": [
    {
      "order": 1,
      "predicate": "Invalid 14-layer structural contract, optional nested PRF productProjection, unknown status, invalid obligations or non-Boolean profile support",
      "result": "REJECTED_MALFORMED"
    },
    {
      "order": 2,
      "predicate": "Any layer or supplied nested PRF product projection has REJECTED_MALFORMED",
      "result": "REJECTED_MALFORMED"
    },
    {
      "order": 3,
      "predicate": "Any layer has CONTRADICTED or VIOLATED, any supplied nested PRF product projection has CONTRADICTED, or recomputation.semanticOutcome is REFUTED",
      "result": "CONTRADICTED"
    },
    {
      "order": 4,
      "predicate": "Profile is unsupported, any required obligation has UNSUPPORTED or UNSUPPORTED_PROFILE, or required PRF product projection is UNSUPPORTED_PROFILE",
      "result": "UNSUPPORTED_PROFILE"
    },
    {
      "order": 5,
      "predicate": "Any required obligation has CANNOT_RECOMPUTE or DIVERGED, or required PRF product projection is CANNOT_RECOMPUTE",
      "result": "CANNOT_RECOMPUTE"
    },
    {
      "order": 6,
      "predicate": "Input not ADMITTED, canonicalization not VERIFIED, native semanticOutcome not VERIFIED, required nested PRF product projection not VERIFIED, or any required success status absent",
      "result": "INSUFFICIENT_EVIDENCE"
    },
    {
      "order": 7,
      "predicate": "All preceding guards clear",
      "result": "VERIFIED"
    }
  ],
