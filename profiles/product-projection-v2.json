      "CONTRADICTED",
      "INSUFFICIENT_EVIDENCE",
      "CANNOT_RECOMPUTE",
      "REJECTED_MALFORMED",
      "UNSUPPORTED_PROFILE"
    ],
    "reason_codes": "Array of nonempty strings; no Boolean or truthy coercion",
    "supplied_failure_precedence": [
      "REJECTED_MALFORMED",
      "CONTRADICTED"
    ],
    "required_obligation_failure_precedence": [
      "UNSUPPORTED_PROFILE",
      "CANNOT_RECOMPUTE",
      "INSUFFICIENT_EVIDENCE"
    ],
    "required_success": "VERIFIED",
    "boundary": "Native PRF tuple product result is separate from PRESERVED/VIOLATED/UNVERIFIABLE transfer status and from the surrounding RVR claim."
  }
