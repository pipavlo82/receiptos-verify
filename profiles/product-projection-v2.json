  "oracle_boundary": "Literal expected outcomes were written independently of projectV2; cases only supply layer records, never derive expected := implementation(actual).",
  "non_claims": [
    "Native PASS or process exit 0 is not semantic evidence.",
    "REPRODUCED does not imply positive semantic outcome.",
    "Optional omitted guarantees and continuity are not silently claimed.",
    "Projection does not establish authenticity, dependency soundness or provenance beyond its input layers.",
