+  ['duplicate accepted authority IDs', f => { f.request.policy.accepted_authorities.push({ id: 'synthetic:key', class: 'INFRASTRUCTURE_ATTESTATION' }); }, 'AUTHORITY_ID_DUPLICATE'],
