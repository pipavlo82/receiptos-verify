diff --git a/src/core/admission-v2.mjs b/src/core/admission-v2.mjs
new file mode 100644
index 0000000..a122a9d
--- /dev/null
+++ b/src/core/admission-v2.mjs
@@ -0,0 +1,62 @@
+import Ajv2020 from 'ajv/dist/2020.js';
+import { readFileSync } from 'node:fs';
+import { canonicalize, base64, problem } from './common.mjs';
+
+const ajv = new Ajv2020({ allErrors: true, strict: true, allowUnionTypes: true });
+const load = name => JSON.parse(readFileSync(new URL(`../../schemas/${name}.schema.json`, import.meta.url), 'utf8'));
+ajv.addSchema(load('claim-surface'));
+const validators = {
+  surface: ajv.getSchema('urn:receiptos:verify:claim-surface:v2'),
+  request: ajv.compile(load('request-v2')),
+  bundle: ajv.compile(load('bundle-v2')),
+  report: ajv.compile(load('report-v2')),
+};
+
+export function validateV2Schema(name, value) {
+  if (!Object.hasOwn(validators, name)) throw problem('SCHEMA_VALIDATOR_UNSUPPORTED', 'Unknown v0.2 schema validator.');
+  // Object API inputs have the same canonical safety boundary as parsed JSON.
+  canonicalize(value);
+  if (!validators[name](value)) throw problem('SCHEMA_MISMATCH', ajv.errorsText(validators[name].errors, { separator: '; ' }));
+  return true;
+}
+
+function uniqueIds(values, code, description) {
+  const ids = new Set();
+  for (const value of values) {
+    if (ids.has(value.id)) throw problem(code, `${description} IDs must be unique, including across differing versions or statuses.`);
+    ids.add(value.id);
+  }
+}
+
+function validateSurfaceRelations(surface) {
+  if (surface.time.not_after <= surface.time.not_before) throw problem('TIME_INTERVAL_MALFORMED', 'Time applicability must be a nonempty half-open interval.');
+  uniqueIds(surface.dependencies, 'DEPENDENCY_ID_DUPLICATE', 'Dependency');
+  const path = surface.subject.artifact_path;
+  if (path !== undefined && path.split('/').some(segment => segment === '.' || segment === '..')) {
+    throw problem('ARTIFACT_PATH_MALFORMED', 'Artifact paths must be relative paths without dot or traversal segments.');
+  }
+}
+
+/** Admit shape and non-ambiguous identity, without grading semantic success. */
+export function admitV2(request, bundle) {
+  validateV2Schema('request', request);
+  validateV2Schema('bundle', bundle);
+  validateSurfaceRelations(request);
+  validateSurfaceRelations(bundle.statement.surface);
+  uniqueIds(request.policy.trusted_keys, 'TRUST_KEY_ID_DUPLICATE', 'Trust key');
+  uniqueIds(request.policy.accepted_authorities, 'AUTHORITY_ID_DUPLICATE', 'Accepted authority');
+  uniqueIds(request.policy.dependency_results, 'DEPENDENCY_RESULT_ID_DUPLICATE', 'Dependency premise');
+  uniqueIds(bundle.statement.evidence_manifest, 'DUPLICATE_EVIDENCE', 'Evidence manifest');
+  uniqueIds(bundle.evidence, 'DUPLICATE_EVIDENCE', 'Evidence attachment');
+  uniqueIds(request.requested_guarantees.filter(value => Object.hasOwn(value, 'id')), 'GUARANTEE_ID_DUPLICATE', 'Requested guarantee');
+  for (const key of request.policy.trusted_keys) base64(key.spki_base64);
+  base64(bundle.signature_base64);
+  for (const evidence of bundle.evidence) if (evidence.bytes_base64 !== null) base64(evidence.bytes_base64);
+  const singularRoles = ['artifact', 'native-result', 'adapter-input', 'git-commit'];
+  for (const role of singularRoles) {
+    if (bundle.statement.evidence_manifest.filter(value => value.role === role).length > 1) {
+      throw problem('AMBIGUOUS_EVIDENCE_ROLE', 'Singular evidence roles cannot have conflicting declarations.');
+    }
+  }
+  return true;
+}
diff --git a/src/core/authenticity-v2.mjs b/src/core/authenticity-v2.mjs
new file mode 100644
index 0000000..620ee6d
--- /dev/null
+++ b/src/core/authenticity-v2.mjs
@@ -0,0 +1,16 @@
+import { createPublicKey, verify } from 'node:crypto';
+import { canonicalize, sha256, base64, result } from './common.mjs';
+export function signingBytesV2(statement) {
+  return Buffer.concat([Buffer.from('receiptos.verify.statement.v2\0','ascii'),Buffer.from(sha256(canonicalize(statement)),'hex')]);
+}
+export function verifyAuthenticityV2(request,bundle) {
+  if (bundle.statement.crypto.provider !== 'ed25519') return result('NOT_ESTABLISHED',['UNSUPPORTED_CRYPTO_PROVIDER']);
+  const keys = request.policy.trusted_keys.filter(key=>key.id===bundle.statement.crypto.key_id);
+  if (keys.length !== 1) return result('NOT_ESTABLISHED',['SIGNER_NOT_TRUSTED']);
+  try {
+    const key = createPublicKey({key:base64(keys[0].spki_base64),format:'der',type:'spki'});
+    const signature = base64(bundle.signature_base64);
+    const valid = key.asymmetricKeyType==='ed25519' && signature.length===64 && verify(null,signingBytesV2(bundle.statement),key,signature);
+    return result(valid?'VERIFIED':'CONTRADICTED',valid?[]:['INVALID_SIGNATURE'],{provider:'ed25519',key_id:bundle.statement.crypto.key_id,boundary:'Authenticates the supplied statement, not arbitrary semantic authority.'});
+  } catch { return result('CONTRADICTED',['INVALID_SIGNATURE']); }
+}
diff --git a/src/core/claim-surface.mjs b/src/core/claim-surface.mjs
new file mode 100644
index 0000000..25c47d8
--- /dev/null
+++ b/src/core/claim-surface.mjs
@@ -0,0 +1,72 @@
+import { canonicalize, equal, result } from './common.mjs';
+
+export const SURFACE_FIELDS = ['claim','subject','scope','authority','policy','version','time','assumptions','dependencies','evidence_requirements'];
+const record = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+const same = (a,b) => a !== undefined && b !== undefined && equal(a,b);
+const dependencyKey = value => JSON.stringify([value.id,value.version]);
+
+// Exact, conservative relation. Scope strings/objects have no implied hierarchy.
+// Premises are independently selected consumer context, never receipt self-grades.
+export function compareClaimSurfaces(requested, evidence, context = {}) {
+  const dimensions = {};
+  const add = (name,status,codes) => { dimensions[name] = {status,reasonCodes:codes}; };
+  try {canonicalize(requested);canonicalize(evidence);canonicalize(context);} catch {return result('INSUFFICIENT_EVIDENCE',['CLAIM_SURFACE_MALFORMED'],null,{dimensions});}
+  if (!record(requested) || !record(evidence) || !record(context)
+      || SURFACE_FIELDS.some(name => !Object.hasOwn(requested,name) || !Object.hasOwn(evidence,name))) {
+    return result('INSUFFICIENT_EVIDENCE',['CLAIM_SURFACE_UNESTABLISHED'],null,{dimensions,requested:requested??null,evidence:evidence??null});
+  }
+  if (![requested.subject,evidence.subject,requested.claim,evidence.claim,requested.authority,evidence.authority,requested.policy,evidence.policy].every(record)
+    || ![requested.assumptions,evidence.assumptions,requested.dependencies,evidence.dependencies,requested.evidence_requirements,evidence.evidence_requirements,context.dependency_results??[]].every(Array.isArray)) {
+    return result('INSUFFICIENT_EVIDENCE',['CLAIM_SURFACE_MALFORMED'],null,{dimensions});
+  }
+  for (const list of [requested.dependencies,evidence.dependencies,context.dependency_results??[]]) {
+    if (list.some(value=>!record(value)||typeof value.id!=='string'||typeof value.version!=='string') || new Set(list.map(value=>value.id)).size!==list.length) return result('INSUFFICIENT_EVIDENCE',['DEPENDENCY_INPUT_AMBIGUOUS'],null,{dimensions});
+  }
+  const compare = (name,a,b,code) => add(name,same(a,b)?'COMPATIBLE':'CONTRADICTED',same(a,b)?[]:[code]);
+  compare('claim',requested.claim,evidence.claim,'CLAIM_MISMATCH');
+  const identity = value => ({kind:value.kind,id:value.id});
+  compare('subject',identity(requested.subject),identity(evidence.subject),'SUBJECT_MISMATCH'); // V02_MUTATE subject
+  const artifact = value => Object.fromEntries(['artifact_digest','tree','artifact_path'].filter(k=>Object.hasOwn(value,k)).map(k=>[k,value[k]]));
+  compare('artifact',artifact(requested.subject),artifact(evidence.subject),'ARTIFACT_MISMATCH');
+  const commit = value => Object.hasOwn(value,'commit')?{commit:value.commit}:{};
+  compare('commit',commit(requested.subject),commit(evidence.subject),'SUBJECT_MISMATCH');
+  compare('authority',requested.authority,evidence.authority,'AUTHORITY_MISMATCH'); // V02_MUTATE authority
+  compare('scope',requested.scope,evidence.scope,'SCOPE_MISMATCH'); // V02_MUTATE scope
+  compare('policy',requested.policy,evidence.policy,'POLICY_MISMATCH'); // V02_MUTATE policy
+  compare('version',{claim:requested.version,subject:requested.subject.version},{claim:evidence.version,subject:evidence.subject.version},'VERSION_MISMATCH'); // V02_MUTATE version
+  const validInterval = value => record(value) && Number.isSafeInteger(value.not_before) && Number.isSafeInteger(value.not_after)
+    && value.not_before >= 0 && value.not_after > value.not_before;
+  const instant = context.verification_time;
+  const timeOk = validInterval(requested.time) && validInterval(evidence.time) && same(requested.time,evidence.time)
+    && Number.isSafeInteger(instant) && instant >= evidence.time.not_before && instant < evidence.time.not_after;
+  add('time',timeOk?'COMPATIBLE':'CONTRADICTED',timeOk?[]:['TIME_MISMATCH']);
+  const established = new Set(context.established_assumptions ?? []);
+  const assumptions = Array.isArray(requested.assumptions) && Array.isArray(evidence.assumptions)
+    && [...new Set([...requested.assumptions,...evidence.assumptions])].every(id=>established.has(id));
+  add('assumptions',assumptions?'COMPATIBLE':'INSUFFICIENT_EVIDENCE',assumptions?[]:['ASSUMPTION_UNESTABLISHED']);
+  const dependencies = new Map((context.dependency_results ?? []).map(value=>[dependencyKey(value),value]));
+  const requestedDeps = requested.dependencies ?? [], evidenceDeps = evidence.dependencies ?? [];
+  const dependencyReasons = [];
+  for (const required of [...requestedDeps,...evidenceDeps]) {
+    const observed = dependencies.get(dependencyKey(required));
+    if (!observed || observed.status !== 'SATISFIED' && observed.status !== 'CONTRADICTED') dependencyReasons.push('DEPENDENCY_MISSING'); // V02_MUTATE dependency-presence
+    if (observed?.status === 'CONTRADICTED') dependencyReasons.push('DEPENDENCY_CONTRADICTED'); // V02_MUTATE dependency-contradiction
+  }
+  for (const required of requestedDeps) {
+    const declared = evidenceDeps.find(value=>value.id===required.id);
+    if (!declared) dependencyReasons.push('DEPENDENCY_MISSING');
+    else if (declared.version !== required.version) dependencyReasons.push('DEPENDENCY_CONTRADICTED');
+  }
+  add('dependencies',dependencyReasons.includes('DEPENDENCY_CONTRADICTED')?'CONTRADICTED':dependencyReasons.length?'INSUFFICIENT_EVIDENCE':'COMPATIBLE',[...new Set(dependencyReasons)]);
+  const basis = new Set(context.evidence_basis ?? []);
+  const sufficient = [...new Set([...requested.evidence_requirements,...evidence.evidence_requirements])].every(kind=>basis.has(kind));
+  add('evidence_basis',sufficient?'COMPATIBLE':'INSUFFICIENT_EVIDENCE',sufficient?[]:['EVIDENCE_BASIS_UNESTABLISHED']);
+  const values = Object.values(dimensions);
+  const status = values.some(value=>value.status==='CONTRADICTED')?'CONTRADICTED'
+    :values.some(value=>value.status==='INSUFFICIENT_EVIDENCE')?'INSUFFICIENT_EVIDENCE':'COMPATIBLE';
+  return result(status,[...new Set(values.flatMap(value=>value.reasonCodes))],null,{dimensions,requested,evidence});
+}
+
+export function requestSurface(request) {
+  return Object.fromEntries(SURFACE_FIELDS.map(name=>[name,name==='policy'?{id:request.policy.id,version:request.policy.version}:request[name]]));
+}
diff --git a/src/core/evidence-v2.mjs b/src/core/evidence-v2.mjs
new file mode 100644
index 0000000..02aa684
--- /dev/null
+++ b/src/core/evidence-v2.mjs
@@ -0,0 +1,42 @@
+import { keys, sha256, digest, base64, problem, result } from './common.mjs';
+import { verifyGitSubject } from './git.mjs';
+export function inspectEvidenceV2(bundle) {
+  const manifest = bundle.statement.evidence_manifest, entries = [], missing = [];
+  const supplied = new Map();
+  for (const item of bundle.evidence) {
+    if (supplied.has(item.id)) throw problem('DUPLICATE_EVIDENCE','Evidence IDs must be unique.');
+    supplied.set(item.id,item.bytes_base64);
+  }
+  const ids = new Set();
+  for (const item of manifest) {
+    if (ids.has(item.id)) throw problem('DUPLICATE_EVIDENCE','Manifest IDs must be unique.');
+    ids.add(item.id);
+    if (!supplied.has(item.id) || supplied.get(item.id)===null) {missing.push(item.id);continue;}
+    const bytes = base64(supplied.get(item.id));
+    if (bytes.length!==item.size || sha256(bytes)!==item.digest) throw problem('ATTACHMENT_INTEGRITY_MISMATCH','Committed attachment bytes differ.');
+    entries.push({...item,bytes});
+  }
+  if ([...supplied.keys()].some(id=>!ids.has(id))) throw problem('UNCOMMITTED_EVIDENCE','Uncommitted attachment.');
+  if (digest(bundle.payload)!==bundle.statement.payload_digest) throw problem('PAYLOAD_INTEGRITY_MISMATCH','Payload differs from its signed commitment.');
+  for (const role of ['artifact','native-result','adapter-input']) if (manifest.filter(item=>item.role===role).length>1) throw problem('AMBIGUOUS_EVIDENCE_ROLE','Singular evidence role repeated.');
+  let git = null;
+  const subject = bundle.statement.surface.subject;
+  if (subject.kind==='git-artifact') {
+    const gitEntries = entries.filter(item=>['artifact','git-commit','git-tree'].includes(item.role));
+    if (['artifact','git-commit','git-tree'].every(role=>gitEntries.some(item=>item.role===role))) {
+      git = verifyGitSubject({type:'git-artifact',objectFormat:'sha1',commit:subject.commit,tree:subject.tree,artifact:{path:subject.artifact_path}},gitEntries);
+      if (sha256(gitEntries.find(item=>item.role==='artifact').bytes)!==subject.artifact_digest) throw problem('ARTIFACT_SUBJECT_MISMATCH','Git closure covers other artifact bytes.');
+    }
+  }
+  return {manifest,entries,missing,git};
+}
+export function evaluateEvidenceV2(inspected, request, native, binding) {
+  const available = new Set(inspected.entries.map(item=>item.id));
+  if (!inspected.manifest.length || !inspected.entries.length) return result('INSUFFICIENT',['EVIDENCE_MISSING']);
+  if (inspected.missing.length || request.evidence.some(id=>!available.has(id))) return result('INSUFFICIENT',['COMMITTED_EVIDENCE_UNAVAILABLE']);
+  if (request.subject.kind==='git-artifact' && !inspected.git) return result('INSUFFICIENT',['GIT_CLOSURE_UNAVAILABLE']);
+  if (request.policy.minimum_grade!=='LOCAL_RECOMPUTATION' || native.execution?.status!=='COMPLETED') return result('INSUFFICIENT',['EVIDENCE_GRADE_NOT_ESTABLISHED']);
+  if (request.adapter==='trustless' && native.evidenceGrade!=='REPRODUCED') return result('INSUFFICIENT',['EVIDENCE_GRADE_NOT_ESTABLISHED']); // V02_MUTATE evidence-grade
+  if (binding.status!=='VERIFIED') return result('INSUFFICIENT',binding.reasonCodes);
+  return result('SUFFICIENT',[],{grade:'LOCAL_RECOMPUTATION',available:[...available],git:inspected.git});
+}
diff --git a/src/core/verify-v2.mjs b/src/core/verify-v2.mjs
new file mode 100644
index 0000000..1d08add
--- /dev/null
+++ b/src/core/verify-v2.mjs
@@ -0,0 +1,128 @@
+import { canonicalize, digest, equal, result, problem } from './common.mjs';
+import { parseStrict } from './strict-json.mjs';
+import { admitV2 } from './admission-v2.mjs';
+import { inspectEvidenceV2, evaluateEvidenceV2 } from './evidence-v2.mjs';
+import { verifyAuthenticityV2 } from './authenticity-v2.mjs';
+import { requestSurface } from './claim-surface.mjs';
+import { projectV2, REQUIRED_V2 } from '../projection/project-v2.mjs';
+import { verifyIntegrity, descriptor as crystal } from '../adapters/crystal.mjs';
+import { recompute, descriptor as rvr } from '../adapters/rvr.mjs';
+import { evaluateSemanticAbi, descriptor as semanticAbi } from '../adapters/semantic-abi-v2.mjs';
+import { evaluateTrustless, descriptor as trustless } from '../adapters/trustless.mjs';
+import { evaluateInterpollV2, actionMaterial, commitActionTrace, descriptor as interpoll } from '../adapters/interpoll-v2.mjs';
+import { evaluatePrfV2, descriptor as prf } from '../adapters/prf-v2.mjs';
+import { evaluateContinuity } from '../adapters/chronicle.mjs';
+
+export const PROFILE_V2 = 'receiptos.verify.generic.v2';
+export const LAYERS_V2 = ['INPUT','CANONICALIZATION',...REQUIRED_V2,'GUARANTEE_PRESERVATION','CONTINUITY','DOMAIN_ADAPTERS','PRODUCT_PROJECTION','EXPLAINABLE_REPORT','PROVENANCE'];
+const adapters = { rvr, 'semantic-abi': rvr, trustless, interpoll };
+const notRun = () => ({...result('CANNOT_RECOMPUTE',['COMMITTED_EVIDENCE_UNAVAILABLE']),semanticOutcome:'UNVERIFIABLE',execution:{status:'NOT_RUN'}});
+
+async function executeAdapter(request,bundle,inspected) {
+  const input = bundle.payload.adapter, surface = bundle.statement.surface;
+  if (!Object.hasOwn(adapters,request.adapter)) return {...result('UNSUPPORTED',['ADAPTER_UNSUPPORTED']),semanticOutcome:'UNVERIFIABLE'};
+  if (inspected.missing.length) return notRun();
+  if (request.adapter==='trustless') return evaluateTrustless(input);
+  if (request.adapter==='interpoll') {
+    const evaluated = evaluateInterpollV2(input,request.adapter_requirement ?? {});
+    // Re-run the supplied trace relation. Supplied observations are not server provenance.
+    const replay = equal(input.final_committed_result,commitActionTrace(input));
+    return {...evaluated,adapterProjection:evaluated.status,
+      status:evaluated.status==='REJECTED_MALFORMED'?'REJECTED_MALFORMED':replay?'REPRODUCED':'DIVERGED',
+      semanticOutcome:evaluated.status==='VERIFIED'?'VERIFIED':evaluated.status==='CONTRADICTED'?'REFUTED':'UNVERIFIABLE',
+      execution:{status:'COMPLETED',runtime:'node',relation:'pinned Schnorr verification and exact supplied trace'}};
+  }
+  if (surface.claim.kind!=='SHA256_EQUALS') return {...result('UNSUPPORTED',['NATIVE_CLAIM_KIND_UNSUPPORTED']),semanticOutcome:'UNVERIFIABLE'};
+  for (const claim of [input?.originalBundle?.claim,input?.candidateCase?.claim]) {
+    if (!claim || claim.schema!=='rvr.claim.sha256-equals.v0' || claim.operation!=='SHA256_EQUALS'
+      || claim.evidenceMember!=='artifact' || claim.expectedDigest!==surface.claim.parameters.expected_digest) {
+      throw problem('NATIVE_CLAIM_MISMATCH','Native RVR predicate differs from the authenticated evidence claim.');
+    }
+  }
+  const native = await recompute(input);
+  return {...native,adapterProjection:native.status,status:native.status==='REJECTED_MALFORMED'?native.status:native.recomputationStatus??native.status};
+}
+
+function nativeBinding(request,bundle,inspected,native) {
+  const surface=bundle.statement.surface, input=bundle.payload.adapter;
+  if (!Object.hasOwn(adapters,request.adapter)) return result('INSUFFICIENT_EVIDENCE',['NATIVE_BINDING_UNSUPPORTED']);
+  const attachment=role=>inspected.entries.find(entry=>entry.role===role);
+  if (!attachment('adapter-input')) return result('INSUFFICIENT_EVIDENCE',['ADAPTER_INPUT_EVIDENCE_MISSING']);
+  if (!attachment('adapter-input').bytes.equals(canonicalize(input))) return result('CONTRADICTED',['ADAPTER_INPUT_COMMITMENT_MISMATCH']);
+  if (surface.authority.id!==bundle.statement.crypto.key_id
+      || surface.authority.class!=='INDEPENDENT_RECOMPUTATION'
+      || !request.policy.accepted_authorities.some(authority=>equal(authority,surface.authority))) return result('CONTRADICTED',['AUTHORITY_MISMATCH']);
+  if (request.adapter!==bundle.statement.adapter) return result('CONTRADICTED',['ADAPTER_BINDING_MISMATCH']);
+  if (['rvr','semantic-abi'].includes(request.adapter)) {
+    if (!equal(surface.claim.parameters,{expected_digest:input.originalBundle?.claim?.expectedDigest??null})) return result('CONTRADICTED',['NATIVE_CLAIM_SURFACE_MISMATCH']);
+    if (!equal(surface.scope,{evidence_member:'artifact'})) return result('CONTRADICTED',['NATIVE_SCOPE_MISMATCH']);
+    const artifact=attachment('artifact'), saved=attachment('native-result');
+    if (!artifact || !saved) return result('INSUFFICIENT_EVIDENCE',['NATIVE_EVIDENCE_MISSING']);
+    if (native.observedArtifactDigest && (native.observedArtifactDigest!==artifact.digest || surface.subject.artifact_digest!==artifact.digest)) return result('CONTRADICTED',['ARTIFACT_MISMATCH']);
+    if (!saved.bytes.equals(canonicalize(input.originalBundle.canonicalResult))) return result('CONTRADICTED',['NATIVE_SAVED_RESULT_MISMATCH']);
+  } else if (request.adapter==='trustless') {
+    const actual=native.nativeBinding;
