{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:receiptos:verify:claim-surface:v2",
  "title": "Caller-selected and evidence-declared generic claim surfaces",
  "description": "Exact conservative relation, not authority authenticity. Half-open time ordering and duplicate identities are enforced by admission.",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 4194304
        },
        {
          "type": "array",
          "items": {
            "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/json"
          },
          "maxItems": 4096
        },
        {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[ -~]{1,128}$"
              },
              {
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/json"
          }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[ -~]{1,128}$"
          },
          {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/json"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "strings": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "parameters": {
          "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/jsonObject"
        }
      },
      "required": [
        "id",
        "kind",
        "parameters"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "scope": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/jsonObject"
    },
    "authority": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "id",
        "class"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "not_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "not_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "not_before",
        "not_after"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "claim": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/claim"
    },
    "subject": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/subject"
    },
    "scope": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/scope"
    },
    "authority": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/authority"
    },
    "policy": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/policy"
    },
    "time": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/time"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "assumptions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/dependency"
      },
      "maxItems": 64
    },
    "evidence_requirements": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1
    }
  },
  "required": [
    "claim",
    "subject",
    "scope",
    "authority",
    "policy",
    "time",
    "version",
    "assumptions",
    "dependencies",
    "evidence_requirements"
  ],
  "additionalProperties": false
}
