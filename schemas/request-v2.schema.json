{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:receiptos:verify:request:v2",
  "title": "ReceiptOS Verify generic caller-selected request v0.2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "receiptos.verify.request.v2"
    },
    "verification_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "claim": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/claim"
    },
    "subject": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/subject"
    },
    "scope": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/scope"
    },
    "authority": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/authority"
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "trusted_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "spki_base64": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "spki_base64"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "required_layers": {
          "type": "array",
          "items": {
            "enum": [
              "INTEGRITY",
              "AUTHENTICITY",
              "SUBJECT_BINDING",
              "RECOMPUTATION",
              "EVIDENCE_SUFFICIENCY",
              "SEMANTIC_COMPATIBILITY",
              "GUARANTEE_PRESERVATION",
              "CONTINUITY",
              "DOMAIN_ADAPTERS"
            ]
          },
          "uniqueItems": true,
          "maxItems": 9
        },
        "minimum_grade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "verification_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "established_assumptions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "dependency_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "status": {
                "enum": [
                  "SATISFIED",
                  "CONTRADICTED",
                  "UNESTABLISHED"
                ]
              }
            },
            "required": [
              "id",
              "version",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "accepted_authorities": {
          "type": "array",
          "items": {
            "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/authority"
          },
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "version",
        "trusted_keys",
        "required_layers",
        "minimum_grade",
        "verification_time",
        "established_assumptions",
        "dependency_results",
        "accepted_authorities"
      ],
      "additionalProperties": false
    },
    "time": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/time"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "assumptions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/dependency"
      },
      "maxItems": 64
    },
    "evidence_requirements": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "requested_guarantees": {
      "type": "array",
      "items": {
        "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/jsonObject"
      },
      "maxItems": 64
    },
    "adapter_requirement": {
      "$ref": "#/$defs/interpollRequirement"
    },
    "guarantee_requirement": {
      "$ref": "#/$defs/prfRequirement"
    },
    "continuity_request": {
      "$ref": "#/$defs/continuityRequirement"
    },
    "semantic_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "schema",
    "verification_profile",
    "adapter",
    "claim",
    "subject",
    "scope",
    "authority",
    "policy",
    "time",
    "version",
    "assumptions",
    "dependencies",
    "evidence_requirements",
    "evidence",
    "requested_guarantees"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^v[1-9][0-9]{0,3}$"
    },
    "actionMaterial": {
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "namespace": { "$ref": "#/$defs/namespace" },
        "kind": { "$ref": "#/$defs/text" },
        "actor": { "$ref": "#/$defs/digest" },
        "targetType": { "enum": ["post", "comment", "poll"] },
        "targetId": { "type": "string", "pattern": "^[a-z0-9_.:-]{1,128}$" },
        "value": { "enum": ["up", "down", "none", "view"] },
        "createdAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      },
      "required": ["version", "namespace", "kind", "actor", "targetType", "targetId", "value", "createdAt", "nonce"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "reaction" } }, "required": ["kind"] },
          "then": { "properties": { "targetType": { "enum": ["post", "comment"] }, "value": { "enum": ["up", "down", "none"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "view" } }, "required": ["kind"] },
          "then": { "properties": { "targetType": { "enum": ["post", "poll"] }, "value": { "const": "view" } } }
        }
      ]
    },
    "actionAuthority": {
      "type": "object",
      "properties": {
        "actor": { "$ref": "#/$defs/digest" },
        "namespace": { "$ref": "#/$defs/text" }
      },
      "required": ["actor", "namespace"],
      "additionalProperties": false
    },
    "interpollRequirement": {
      "type": "object",
      "properties": {
        "requested_action": { "$ref": "#/$defs/actionMaterial" },
        "authority": { "$ref": "#/$defs/actionAuthority" },
        "required_outcome": { "enum": ["EXECUTION_OBSERVED", "AUTHORIZATION_ONLY"] }
      },
      "additionalProperties": false
    },
    "nativePrfResult": {
      "type": "object",
      "properties": {
        "outcome": { "enum": ["PRESERVED", "VIOLATED", "UNVERIFIABLE"] },
        "reason": { "$ref": "#/$defs/text" }
      },
      "required": ["outcome", "reason"],
      "additionalProperties": false
    },
    "acceptedBasis": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/dependency" },
          "maxItems": 64
        }
      },
      "required": ["id", "dependencies"],
      "additionalProperties": false
    },
    "prfRequirement": {
      "type": "object",
      "properties": {
        "required_relation_input_digest": { "$ref": "#/$defs/digest" },
        "accepted_basis": { "$ref": "#/$defs/acceptedBasis" },
        "required_native_result": { "$ref": "#/$defs/nativePrfResult" },
        "required_guarantee": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "continuityRequirement": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["historical", "current"] },
        "entry_id": { "$ref": "#/$defs/text" },
        "subject": { "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/json" },
        "state": { "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/json" },
        "receipt_root": { "$ref": "#/$defs/text" },
        "proof_object_ref": { "$ref": "#/$defs/text" },
        "observation_envelope_digest": { "$ref": "#/$defs/digest" },
        "require_whole_envelope_binding": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
