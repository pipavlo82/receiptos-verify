{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:receiptos:verify:request:v2",
  "title": "ReceiptOS Verify generic caller-selected request v0.2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "receiptos.verify.request.v2"
    },
    "verification_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "claim": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/claim"
    },
    "subject": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/subject"
    },
    "scope": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/scope"
    },
    "authority": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/authority"
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "trusted_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "spki_base64": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "spki_base64"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "required_layers": {
          "type": "array",
          "items": {
            "enum": [
              "INTEGRITY",
              "AUTHENTICITY",
              "SUBJECT_BINDING",
              "RECOMPUTATION",
              "EVIDENCE_SUFFICIENCY",
              "SEMANTIC_COMPATIBILITY",
              "GUARANTEE_PRESERVATION",
              "CONTINUITY",
              "DOMAIN_ADAPTERS"
            ]
          },
          "uniqueItems": true,
          "maxItems": 9
        },
        "minimum_grade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "verification_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "established_assumptions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "dependency_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "status": {
                "enum": [
                  "SATISFIED",
                  "CONTRADICTED",
                  "UNESTABLISHED"
                ]
              }
            },
            "required": [
              "id",
              "version",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "accepted_authorities": {
          "type": "array",
          "items": {
            "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/authority"
          },
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "version",
        "trusted_keys",
        "required_layers",
        "minimum_grade",
        "verification_time",
        "established_assumptions",
        "dependency_results",
        "accepted_authorities"
      ],
      "additionalProperties": false
    },
    "time": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/time"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "assumptions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/dependency"
      },
      "maxItems": 64
    },
    "evidence_requirements": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true,
      "maxItems": 256
    },
    "requested_guarantees": {
      "type": "array",
      "items": {
        "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/jsonObject"
      },
      "maxItems": 64
    },
    "adapter_requirement": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/jsonObject"
    },
    "guarantee_requirement": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/jsonObject"
    },
    "continuity_request": {
      "$ref": "urn:receiptos:verify:claim-surface:v2#/$defs/jsonObject"
    },
    "semantic_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "schema",
    "verification_profile",
    "adapter",
    "claim",
    "subject",
    "scope",
    "authority",
    "policy",
    "time",
    "version",
    "assumptions",
    "dependencies",
    "evidence_requirements",
    "evidence",
    "requested_guarantees"
  ],
  "additionalProperties": false
}
