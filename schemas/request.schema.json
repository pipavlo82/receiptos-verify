{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:receiptos:verify:request:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "receiptos.verify.request.v1"
    },
    "verification_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "claim": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "SHA256_EQUALS"
        },
        "expected_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "expected_digest"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "git-artifact"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "kind",
        "id",
        "artifact_digest",
        "commit",
        "tree",
        "artifact_path",
        "version"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "trusted_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "spki_base64": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "spki_base64"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "required_layers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "minimum_grade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "verification_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version",
        "trusted_keys",
        "required_layers",
        "minimum_grade",
        "verification_time"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "semantic_requirement": {
      "$ref": "urn:receiptos:verify:semantic-contract:v1"
    },
    "requested_guarantees": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 256
    },
    "continuity_request": {
      "type": "object"
    },
    "domain_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "domain_requirement": {
      "type": "object"
    },
    "guarantee_context": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "verification_profile",
    "claim",
    "subject",
    "policy",
    "evidence",
    "semantic_requirement",
    "requested_guarantees"
  ],
  "additionalProperties": false
}
