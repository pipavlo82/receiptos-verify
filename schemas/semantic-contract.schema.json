{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:receiptos:verify:semantic-contract:v1",
  "title": "ReceiptOS neutral semantic contract with explicit product extensions",
  "description": "Original schema; not upstream Semantic ABI manifest wire conformance. Independent context establishes actual authority/evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_type", "authority_class", "subject", "scope", "valid_after", "valid_until", "assumptions", "evidence_requirements"],
  "properties": {
    "claim_type": {"type": "string", "minLength": 1},
    "authority_class": {"enum": ["INDEPENDENT_JUDGMENT", "CRYPTOGRAPHIC_VERIFICATION", "EX_POST_VALIDATION", "INFRASTRUCTURE_ATTESTATION", "ONCHAIN_COMMITMENT", "INDEPENDENT_RECOMPUTATION", "KEY_BINDING_AUTHORITY", "SEMANTIC_VERIFICATION"]},
    "subject": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "scope": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "valid_after": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "valid_until": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "issued_at": {"type": "string", "minLength": 1},
    "verification_time": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "evidence_requirements": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  },
  "not": {"properties": {"issued_at": {}, "verification_time": {}}, "required": ["issued_at", "verification_time"]}
}
